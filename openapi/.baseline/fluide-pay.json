    "/api/v1/payments/transactions": {
      "get": {
        "operationId": "TransactionsController_list",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Free-text search (endpoint-specific)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-indexed)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sort in the format field:direction (e.g. createdAt:desc)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "required": false,
            "in": "query",
            "description": "Filter transactions created on/after this date (ISO string)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "required": false,
            "in": "query",
            "description": "Filter transactions created on/before this date (ISO string)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREDIT",
                "DEBIT"
              ]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "COMPLETED",
                "FAILED",
                "REVERSED"
              ]
            }
          },
          {
            "name": "currency",
            "required": false,
            "in": "query",
            "description": "ISO currency code (e.g. USD)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "walletId",
            "required": false,
            "in": "query",
            "description": "Filter to a specific wallet id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reference",
            "required": false,
            "in": "query",
            "description": "Filter to an exact reference",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerReference",
            "required": false,
            "in": "query",
            "description": "Filter to an exact provider reference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List transactions for the active organization",
        "tags": [
          "transactions"
        ]
      }
    },
