  "info": {
    "title": "Fluide Pay API",
    "description": "Digital wallets, transactions, checkout sessions, payouts, and collections. Supports async settlement via Kafka.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "App",
      "description": "Service root and build metadata. Use for quick connectivity checks.",
      "x-group": "Operations"
    },
    {
      "name": "Prometheus",
      "description": "Prometheus scrape endpoint in text exposition format. Configure your metrics collector to poll this path on each service.",
      "x-group": "Operations"
    },
    {
      "name": "wallets"
    },
    {
      "name": "internal-wallets"
    },
    {
      "name": "transactions"
    },
    {
      "name": "MobileMoney"
    },
    {
      "name": "Payments capabilities"
    },
    {
      "name": "Payments capabilities (internal admin)"
    },
    {
      "name": "billing"
    },
    {
      "name": "billing-internal"
    },
    {
      "name": "billing-payments"
    },
    {
      "name": "Internal Payouts"
    },
    {
      "name": "AR Collection Internal"
    }
  ],
  "servers": [
    {
      "url": "https://staging.api.fluidehr.com",
      "description": "Beta (staging)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreatePayWalletDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "example": "XAF"
          },
          "walletType": {
            "type": "string",
            "enum": [
              "PRIMARY",
              "OPERATING",
              "SAVINGS",
              "ESCROW"
            ],
            "default": "SAVINGS"
          }
        },
        "required": [
          "companyId",
          "currency"
        ]
      },
      "NameDto": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "example": "King"
          },
          "last": {
            "type": "string",
            "example": "LeBron"
          }
        },
        "required": [
          "first",
          "last"
        ]
      },
      "MobileMoneyDto": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "example": "MTN"
          },
          "country": {
            "type": "string",
            "example": "CM"
          },
          "msisdn": {
            "type": "string",
            "example": "237653033620"
          }
        },
        "required": [
          "network",
          "country",
          "msisdn"
        ]
      },
      "EvaluateCapabilityDto": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "providerCode": {
            "type": "string",
            "example": "processor"
          },
          "rail": {
            "type": "string",
            "enum": [
              "BANK_TRANSFER",
              "MOBILE_MONEY"
            ]
          },
          "currency": {
            "type": "string",
            "example": "KES",
            "minLength": 3,
            "maxLength": 3
          },
          "countryCode": {
            "type": "string",
            "example": "KE",
            "minLength": 2,
            "maxLength": 2
          }
        },
        "required": [
          "organizationId",
          "providerCode",
          "rail",
          "currency"
        ]
      },
      "CreatePaymentProviderDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "processor"
          },
          "displayName": {
            "type": "string",
            "example": "processor"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "displayName"
        ]
      },
      "UpdatePaymentProviderDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "UpsertProviderRailDto": {
        "type": "object",
        "properties": {
          "rail": {
            "type": "string",
            "enum": [
              "BANK_TRANSFER",
              "MOBILE_MONEY"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "rail"
        ]
      },
      "SetActiveDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active"
        ]
      },
      "AddProviderCorridorDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "example": "XAF"
          },
          "countryCode": {
            "type": "string",
            "example": "CM"
          },
          "metadata": {
            "type": "object",
            "description": "Opaque JSON metadata attached to the corridor row"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "currency"
        ]
      },
      "PublishCapabilitiesDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string"
          },
          "publishedBy": {
            "type": "string",
            "description": "Opaque operator identifier (email/subject id)"
          }
        }
      },
      "UpsertBillingDto": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "starter",
              "essential",
              "growth",
              "enterprise"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "past_due",
              "suspended",
              "canceled"
            ],
            "default": "active"
          },
          "billingCurrency": {
            "type": "string",
            "example": "XAF"
          },
          "billingProvider": {
            "type": "string",
            "enum": [
              "stripe",
              "flutterwave"
            ]
          },
          "providerCustomerId": {
            "type": "string",
            "description": "External provider customer id"
          },
          "providerSubscriptionId": {
            "type": "string",
            "description": "External provider recurring contract id where applicable"
          },
          "bandMin": {
            "type": "number",
            "example": 1
          },
          "bandMax": {
            "type": "number",
            "example": 4,
            "description": "Null means unlimited"
          },
          "unitPricePerEmployee": {
            "type": "number",
            "example": 2500
          },
          "overageUnitPrice": {
            "type": "number",
            "example": 2500
          }
        },
        "required": [
          "organizationId",
          "plan"
        ]
      },
      "EnsureBillingCustomerDto": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "owner@acme.com"
          },
          "name": {
            "type": "string",
            "example": "Acme Owner"
          },
          "phone": {
            "type": "string",
            "example": "+237653033620"
          }
        },
        "required": [
          "organizationId",
          "email"
        ]
      },
      "BillingMobileMoneyCheckoutDto": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "starter",
              "essential",
              "growth",
              "enterprise"
            ],
            "description": "Used to create billing row if missing."
          },
          "countryCode": {
            "type": "string",
            "example": "233",
            "description": "Mobile money country calling code (digits only)."
          },
          "network": {
            "type": "string",
            "example": "MTN",
            "description": "Mobile money network identifier."
          },
          "phoneNumber": {
            "type": "string",
            "example": "9012345678",
            "description": "Mobile money phone number (digits only)."
          },
          "scenarioKey": {
            "type": "string",
            "example": "scenario:auth_pin&issuer:approved",
            "description": "Optional scenario key for sandbox testing."
          },
          "redirectUrl": {
            "type": "string",
            "example": "http://localhost:3000/billing/return",
            "description": "Absolute redirect URL the hosted checkout sends the user back to after authorization."
          },
          "debug": {
            "type": "boolean",
            "example": true,
            "description": "When true, include sanitized processor request/response payloads for debugging."
          },
          "discountCode": {
            "type": "string",
            "description": "Optional discount code (platform-managed)"
          }
        },
        "required": [
          "countryCode",
          "network",
          "phoneNumber"
        ]
      },
      "RecipientDto": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/NameDto"
          },
          "mobile_money": {
            "$ref": "#/components/schemas/MobileMoneyDto"
          }
        },
        "required": [
          "name",
          "mobile_money"
        ]
      },
      "BillMobileMoneyPayoutDto": {
        "type": "object",
        "properties": {
          "billId": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "example": "XAF"
          },
          "reference": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "recipient": {
            "$ref": "#/components/schemas/RecipientDto"
          }
        },
        "required": [
          "billId",
          "organizationId",
          "companyId",
          "amount",
          "currency",
          "reference",
          "narration",
          "recipient"
        ]
      },
      "ArCheckoutMomoDto": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          }
        },
        "required": [
          "countryCode",
          "network",
          "phoneNumber"
        ]
      },
      "ArCheckoutCardDto": {
        "type": "object",
        "properties": {
          "card_number": {
            "type": "string"
          },
          "expiry_month": {
            "type": "string"
          },
          "expiry_year": {
            "type": "string"
          },
          "cvv": {
            "type": "string"
          }
        },
        "required": [
          "card_number",
          "expiry_month",
          "expiry_year",
          "cvv"
        ]
      },
      "ArCheckoutDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "STRIPE_CARD",
              "FLUTTERWAVE_CARD",
              "FLUTTERWAVE_MOBILE_MONEY",
              "FLUTTERWAVE_USSD",
              "FLUTTERWAVE_OPAY"
            ]
          },
          "amountMinor": {
            "type": "number",
            "description": "Amount in minor units (cents)"
          },
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "successUrl": {
            "type": "string"
          },
          "cancelUrl": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "momo": {
            "$ref": "#/components/schemas/ArCheckoutMomoDto"
          },
          "ussdBankCode": {
            "type": "string"
          },
          "card": {
            "$ref": "#/components/schemas/ArCheckoutCardDto"
          }
        },
        "required": [
          "channel",
          "amountMinor",
          "currency",
          "successUrl",
          "cancelUrl",
          "customerEmail",
          "metadata"
        ]
      }
    }
  },
  "x-mint": {
    "productOverview": "/pay/overview",
    "basePath": "/api/v1/payments"
  }
}
